# ─────────────────────────────────────────────────────────────────────────────
# CodeMap AI — Next.js Frontend Cockpit
# Multi-stage build: deps → builder → runner
# Build context: repository root (see docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: install dependencies ────────────────────────────────────────────
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY codemap-ui/package.json codemap-ui/package-lock.json ./
RUN npm ci --frozen-lockfile

# ── Stage 2: build the Next.js application ───────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# Inherit node_modules from the deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy the entire UI source tree
COPY codemap-ui/ ./

# BACKEND_URL is injected at build time so next.config.ts rewrites resolve
# correctly inside the container network (defaults to Docker service name).
ARG BACKEND_URL=http://backend:8000
ENV NEXT_PUBLIC_BACKEND_URL=$BACKEND_URL

# Disable Next.js telemetry during build
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ── Stage 3: minimal production runtime ──────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create a non-root user for security
RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

# Copy only the files needed to run the built application
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "server.js"]
